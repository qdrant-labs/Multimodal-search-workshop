# Required - your own free Gemini key (query embedding, AI summary,
# transcription, discovery normalization): https://aistudio.google.com
GEMINI_API_KEY=

# Required for real speaker diarization in indexing jobs (falls back to
# Gemini transcription without it). Accept model terms at all three:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Working Qdrant target — local writable instance (docker run -p 6333:6333
# -v ./data/qdrant_docker:/qdrant/storage qdrant/qdrant). Leave the API key
# empty for local. Point at a cloud cluster instead if you have a writable one.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Clone source — shared workshop cluster (read-only key from your instructor).
# Used by clone_collection / scripts/migrate_to_local.py and the web app's
# "Clone to local" button.
CLOUD_QDRANT_URL=
CLOUD_QDRANT_API_KEY=

# Transcription backend for indexing jobs (ingest/02 -> jobs.py whisper path).
#   TRANSCRIBE_BACKEND: faster-whisper (default, CTranslate2 int8, 3-5x faster
#     on CPU) | openai-whisper (reference). Falls back to openai-whisper if
#     faster-whisper can't be imported.
#   WHISPER_MODEL: whisper model size (default "base"; tiny/small/medium/large).
#   WHISPER_DEVICE: force cuda/mps/cpu (default: auto; openai path defaults to
#     cpu since MPS is slower than CPU for whisper 'base').
#   DIARIZATION_MODEL: pyannote pipeline (default
#     pyannote/speaker-diarization-community-1; falls back to 3.1).
TRANSCRIBE_BACKEND=faster-whisper
WHISPER_MODEL=base
WHISPER_DEVICE=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Live news context, earnings-call discovery, and knowledge graphs
# (without it, cached news is used): https://my.asknews.app
ASKNEWS_API_KEY=

# Web search for earnings-call discovery + page snapshots for news links
# missing a summary: https://firecrawl.dev
FIRECRAWL_API_KEY=
